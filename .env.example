# =================================================================
# RIO AI REPRESENTATIVE - ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Google Gemini AI (Required for live Gemini LLM reasoning)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase PostgreSQL (Required for cloud lead & conversation persistence)
# Obtain at: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Resend Transactional Email (Required for instant lead alerts)
# Obtain at: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=RIO Representative <onboarding@resend.dev>
NOTIFICATION_EMAIL=annujaswanth15@gmail.com

# 4. Vapi Voice Telephony (Required for automated outbound phone calls)
# Obtain at: https://vapi.ai/
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# 5. Whisper Speech-To-Text (Optional - fallback to browser Web Speech API if omitted)
OPENAI_API_KEY=your_openai_api_key_for_whisper

# 6. Admin Portal Passcode (Optional - defaults to "rio2026")
ADMIN_PASSCODE=rio2026
